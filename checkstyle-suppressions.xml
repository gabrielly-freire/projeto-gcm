<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.0//EN"
    "https://checkstyle.org/dtds/suppressions_1_0.dtd">

<suppressions>

    <!-- Javadoc não é exigido neste projeto -->
    <suppress checks="JavadocMethod"   files=".*\.java"/>
    <suppress checks="JavadocType"     files=".*\.java"/>
    <suppress checks="JavadocVariable" files=".*\.java"/>

    <!-- Toda nomenclatura ignorada nos arquivos de teste -->
    <suppress checks="MethodName"             files=".*[Tt]est.*\.java"/>
    <suppress checks="LocalVariableName"      files=".*[Tt]est.*\.java"/>
    <suppress checks="LocalFinalVariableName" files=".*[Tt]est.*\.java"/>
    <suppress checks="MemberName"             files=".*[Tt]est.*\.java"/>
    <suppress checks="ParameterName"          files=".*[Tt]est.*\.java"/>
    <suppress checks="ConstantName"           files=".*[Tt]est.*\.java"/>
    <suppress checks="LambdaParameterName"    files=".*[Tt]est.*\.java"/>
    <suppress checks="CatchParameterName"     files=".*[Tt]est.*\.java"/>

    <!-- Records com corpo vazio {} são idiomáticos em DTOs -->
    <suppress checks="WhitespaceAround" files=".*dto.*\.java"/>

</suppressions>
